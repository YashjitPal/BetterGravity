{
  "name": "bettergravity",
  "version": "0.1.3",
  "private": true,
  "description": "An open community modification platform for Google Antigravity.",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bettergravity/installer dev",
    "clean": "node scripts/clean-generated.mjs",
    "build": "pnpm -r --if-present build",
    "build:installer": "pnpm --filter @bettergravity/installer build:desktop",
    "start:installer": "pnpm --filter @bettergravity/installer start:desktop",
    "patch": "node scripts/dev-patch.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:structure": "node scripts/verify-structure.mjs",
    "check": "pnpm verify:structure && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
