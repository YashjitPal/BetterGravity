{
  "name": "@bettergravity/installer",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "The BetterGravity Windows installer.",
  "author": "BetterGravity Contributors",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "pnpm build && electron-builder --win nsis",
    "start:desktop": "electron electron/main.cjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bettergravity/core": "workspace:*",
    "@bettergravity/patcher": "workspace:*",
    "@bettergravity/shared": "workspace:*"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.bettergravity.installer",
    "productName": "BetterGravity Installer",
    "artifactName": "BetterGravity-Installer-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BetterGravity Installer",
      "deleteAppDataOnUninstall": false
    }
  }
}
