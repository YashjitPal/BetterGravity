{
  "name": "@bettergravity/installer",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "The BetterGravity Windows installer.",
  "author": "BetterGravity Contributors",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node build-electron.mjs",
    "build:desktop": "pnpm build && electron-builder --win portable",
    "start:desktop": "electron dist-electron/main.cjs",
    "dev:desktop": "cross-env BG_DEV_SERVER_URL=http://127.0.0.1:4173 electron dist-electron/main.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bettergravity/patcher": "workspace:*",
    "@bettergravity/runtime": "workspace:*",
    "@bettergravity/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^10.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.bettergravity.installer",
    "productName": "BetterGravity Installer",
    "artifactName": "BetterGravity-Installer-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "dist-electron/runtime/**"
    ],
    "directories": {
      "output": "../../release-0.1.3"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    }
  }
}
